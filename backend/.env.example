# Copy this file to `.env` and fill in a key. `.env` is gitignored.
#   cp .env.example .env   then edit .env
#
# Set ONE provider's key. With neither, the import feature falls back to a crude
# regex parser (no PDF/image reading, no real due-date extraction).

# --- Option A: Google Gemini (free tier, reads PDFs/images) ---------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Option B: Anthropic (paid, strongest quality) ------------------------
ANTHROPIC_API_KEY=

# --- Provider selection ---------------------------------------------------
# Force a provider: "gemini" or "anthropic". If unset, the first one with a key
# wins (Anthropic preferred). Handy if you set both keys but want the free one.
# CADENCE_PROVIDER=gemini

# --- Optional model overrides ---------------------------------------------
# CADENCE_GEMINI_MODEL=gemini-3.6-flash
# CADENCE_MODEL=claude-sonnet-5
