# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#   cp .env.example .env   then edit .env

# Your Anthropic API key. Without it, the import feature falls back to a crude
# regex parser (no PDF/image reading, no real due-date extraction).
ANTHROPIC_API_KEY=

# Optional: which model parses syllabi. Defaults to claude-opus-5 (strongest).
# For lower cost use claude-sonnet-5.
# CADENCE_MODEL=claude-sonnet-5
